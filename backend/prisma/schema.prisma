generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  permissions        String[]
  createdAt          DateTime @default(now())
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  phone              String?
  recoveryCode       String?
}

model Client {
  id                 String         @id @default(uuid())
  name               String
  phone              String
  addresses          String[]
  totalOrders        Int            @default(0)
  lastOrderDate      String?
  addressNumber      String?
  avatarUrl          String?
  cep                String?
  city               String?
  complement         String?
  document           String?
  email              String?
  googleId           String?        @unique
  mustChangePassword Boolean        @default(false)
  neighborhood       String?
  password           String?
  pin                String?
  recoveryCode       String?
  state              String?
  street             String?
  webauthnCounter    Int            @default(0)
  webauthnId         String?        @unique
  webauthnPublicKey  String?
  notifications      Notification[]
  orders             Order[]
  receivables        Receivable[]
}

model Waiter {
  id            String         @id @default(uuid())
  name          String
  phone         String
  active        Boolean        @default(true)
  email         String?        @unique
  orders        Order[]
  tableSessions TableSession[]
}

model Product {
  id           String       @id @default(uuid())
  name         String
  price        Float
  category     String
  stock        Int          @default(0)
  imageUrl     String
  active       Boolean      @default(true)
  cest         String?
  cfop         String?
  ncm          String?
  preparation  String?
  comboItems   ComboItem[]  @relation("ComboParent")
  partOfCombos ComboItem[]  @relation("ComboChild")
  orderItems   OrderItem[]
  recipe       RecipeItem[]
  isPizza      Boolean      @default(false)
  pizzaSize    String?
}

model InventoryItem {
  id        String              @id @default(uuid())
  name      String
  unit      UnitType
  quantity  Float
  minStock  Float
  cost      Float
  movements InventoryMovement[]
  recipes   RecipeItem[]
}

model InventoryMovement {
  id              String        @id @default(uuid())
  timestamp       DateTime      @default(now())
  inventoryItemId String
  type            String
  quantity        Float
  reason          String
  orderId         String?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model RecipeItem {
  id              String        @id @default(uuid())
  productId       String
  inventoryItemId String
  quantity        Float
  wasteFactor     Float
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  productId String
  quantity  Int
  combo     Product @relation("ComboParent", fields: [comboId], references: [id])
  product   Product @relation("ComboChild", fields: [productId], references: [id])
}

model SupportMessage {
  id        String   @id @default(uuid())
  clientId  String?
  userName  String?
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

model Order {
  id                  String           @id @default(uuid())
  clientId            String?
  clientName          String
  clientAddress       String?
  clientPhone         String?
  total               Float
  status              OrderStatus      @default(PENDING)
  type                SaleType
  createdAt           DateTime         @default(now())
  paymentMethod       String?
  driverId            String?
  tableNumber         Int?
  waiterId            String?
  appliedServiceFee   Float?
  assignedAt          DateTime?
  clientCep           String?
  clientCity          String?
  clientComplement    String?
  clientDocument      String?
  clientEmail         String?
  clientNeighborhood  String?
  clientState         String?
  clientStreet        String?
  couponId            String?
  deliveryFee         Float?
  digitalPin          String?
  digitalToken        String?
  discountValue       Float?           @default(0)
  isOriginDeliveryApp Boolean          @default(false)
  isOriginDigitalMenu Boolean          @default(false)
  mpPaymentId         String?
  mpPreferenceId      String?
  nfeError            String?
  nfeNumber           String?
  nfeStatus           String?
  nfeUrl              String?
  paymentStatus       String?          @default("PENDING")
  splitAmount1        Float?
  updatedAt           DateTime         @default(now()) @updatedAt
  client              Client?          @relation(fields: [clientId], references: [id])
  coupon              Coupon?          @relation(fields: [couponId], references: [id])
  driver              DeliveryDriver?  @relation(fields: [driverId], references: [id])
  waiter              Waiter?          @relation(fields: [waiterId], references: [id])
  items               OrderItem[]
  messages            OrderMessage[]
  rejections          OrderRejection[]
  receivables         Receivable[]
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  type          String
  value         Float?    @default(0)
  minOrderValue Float?    @default(0)
  maxDiscount   Float?
  startDate     DateTime  @default(now())
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  orders        Order[]
}

model Campaign {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String
  segment     String?
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  imageUrl    String?
  couponCode  String?
  termsText   String?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  clientId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  imageUrl  String?
  couponCode String?
  termsText String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}

model Receivable {
  id            String    @id @default(uuid())
  clientId      String
  orderId       String
  amount        Float
  dueDate       DateTime
  paymentMethod String?
  status        String    @default("PENDING")
  observations  String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  client        Client    @relation(fields: [clientId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id             String        @id @default(uuid())
  orderId        String?
  tableSessionId Int?
  productId      String
  quantity       Float
  price          Float
  isReady        Boolean       @default(false)
  readyAt        DateTime?
  skipKitchen    Boolean       @default(false)
  observations   String?
  pizzaFlavors   String?
  order          Order?        @relation(fields: [orderId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [tableNumber])
}

model TableSession {
  tableNumber         Int           @id
  status              SessionStatus @default(available)
  clientName          String?
  clientId            String?
  waiterId            String?
  startTime           DateTime      @default(now())
  clientAddress       String?
  clientPhone         String?
  clientCep           String?
  clientComplement    String?
  clientDocument      String?
  clientEmail         String?
  hasPendingDigital   Boolean       @default(false)
  isOriginDigitalMenu Boolean       @default(false)
  pendingReviewItems  String?
  pin                 String?
  sessionToken        String?
  items               OrderItem[]
  waiter              Waiter?       @relation(fields: [waiterId], references: [id])
}

model DeliveryDriver {
  id           String           @id @default(uuid())
  name         String
  phone        String
  email        String?
  address      String?
  vehiclePlate String
  vehicleModel String
  vehicleBrand String
  vehicleType  VehicleType
  status       DriverStatus     @default(AVAILABLE)
  active       Boolean          @default(true)
  orders       Order[]
  rejections   OrderRejection[]
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String
  userName  String
  action    String
  details   String
}

model BusinessSettings {
  key                  String  @id
  name                 String
  cnpj                 String
  address              String
  phone                String
  deliveryFee          String
  tableCount           Int
  appBannerUrl         String?
  autoCloseTime        String  @default("00:00")
  campaignLogoUrl      String?
  cscId                String?
  cscToken             String?
  enableDeliveryApp    Boolean @default(true)
  enableDigitalMenu    Boolean @default(true)
  enableDriverApp      Boolean @default(true)
  enableNfcEmission    Boolean @default(false)
  enableWaiterApp      Boolean @default(true)
  facebook             String?
  geofenceRadius       Int     @default(30)
  ie                   String?
  instagram            String?
  isManuallyClosed     Boolean @default(false)
  isNfeProduction      Boolean @default(false)
  maxChange            Float   @default(191)
  operatingHours       String  @default("[]")
  orderTimeoutMinutes  Int     @default(5)
  printerIp            String?
  printerType          String  @default("EPSON")
  qrCodeBaseUrl        String?
  restaurantLat        Float?
  restaurantLng        Float?
  serviceFeePercentage Float   @default(10)
  serviceFeeStatus     Boolean @default(true)
  waiterLockEnabled    Boolean @default(true)
  waiterPrivacyEnabled Boolean @default(false)
  waiterPrivacyTimer   Int     @default(60)
  website              String?
  appBannerUrl2        String?
  appBannerUrl3        String?
  notificationTermsTemplate String?
  pizzaPriceRule       String  @default("HIGHEST")
  pizzaNfeRule         String  @default("OBSERVATION")
  paymentMethods       Json?
  pixKey               String?
}

model ChatMessage {
  id           String   @id @default(uuid())
  content      String
  timestamp    DateTime @default(now())
  driverId     String
  isFromDriver Boolean
  senderName   String
}

model OrderRejection {
  id        String         @id @default(uuid())
  timestamp DateTime       @default(now())
  orderId   String
  driverId  String
  type      RejectionType
  reason    String?
  driver    DeliveryDriver @relation(fields: [driverId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id])
}

model CashSession {
  id             String    @id @default(uuid())
  openedAt       DateTime  @default(now())
  openedBy       String
  openedByName   String
  initialBalance Float
  closedAt       DateTime?
  closedBy       String?
  closedByName   String?
  status         String    @default("OPEN")
  reportedCash   Float?
  reportedPix    Float?
  reportedCredit Float?
  reportedDebit  Float?
  reportedOthers Float?
  reportedFiado  Float?
  systemCash     Float?
  systemPix      Float?
  systemCredit   Float?
  systemDebit    Float?
  systemOthers   Float?
  systemFiado    Float?
  totalSales     Float?
  orphanSales    Float?
  difference     Float?
  observations   String?
}

model Feedback {
  id          String   @id @default(uuid())
  name        String?
  message     String
  tableNumber Int
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model OrderMessage {
  id        String   @id @default(uuid())
  orderId   String
  sender    String
  text      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PARTIALLY_READY
  REOPENED
}

enum SaleType {
  COUNTER
  TABLE
  OWN_DELIVERY
  THIRD_PARTY
}

enum UnitType {
  G
  ML
  UN
  KG
  L
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VehicleType {
  Moto
  Carro
  Bicicleta
}

enum SessionStatus {
  available
  occupied
  billing
}

enum RejectionType {
  AUTO
  MANUAL
}
